# Copy to .env at the repo root (gitignored). The server and the Vite client
# both read this one file. Everything is optional for local mock play:
# `npm run dev`, then open http://localhost:5173/?mock=1&name=Alice
#
# Never put real secrets in this file. On Railway, set variables on the app
# service instead (see docs/SETUP.md, path D).

# --- Database ---------------------------------------------------------------
# Postgres connection string. Leave blank to use embedded PGlite (no install).
# Migrations are applied at boot either way.
# Local Postgres is installed natively (no Docker), e.g.:
#   DATABASE_URL=postgresql://poker:poker@localhost:5432/poker
# On Railway use the reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# PGlite only (DATABASE_URL blank): keep data on disk in this directory,
# relative to packages/server. Unset = in memory, lost on restart.
# .data/ is gitignored.
# PGLITE_DATA_DIR=.data/pglite

# --- Sessions ---------------------------------------------------------------
# Signs session tokens (HS256). Required in production; blank in dev means a
# random secret per run, so restarting the server signs everyone out.
JWT_SECRET=

# Mock sign-in (?mock=1&name=...) is on in development and always off in
# production (NODE_ENV=production or any Railway environment).
# Set to 0 to turn it off locally as well.
# MOCK_AUTH=0

# --- Discord ----------------------------------------------------------------
# From the Discord Developer Portal. Only needed to run inside Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token: server nicknames, guild avatars and the instance check below.
DISCORD_BOT_TOKEN=

# Set to 1 to refuse join_room unless Discord confirms the player is in that
# Activity instance (needs DISCORD_CLIENT_ID and DISCORD_BOT_TOKEN).
# VERIFY_ACTIVITY_INSTANCE=1

# --- Client (Vite; inlined at build time) -----------------------------------
# Same value as DISCORD_CLIENT_ID. Changing it needs a rebuild/redeploy.
VITE_DISCORD_CLIENT_ID=

# --- Development only -------------------------------------------------------
# Server port. Defaults to 3001. Never set it on Railway (Railway injects it).
# PORT=3001

# Where the Vite dev server proxies /api and /socket.io.
# Defaults to http://localhost:3001; change it to run a second stack.
# VITE_PROXY_TARGET=http://localhost:3002

# Real-Postgres test runs: npm run test:pg -w @poker/server
# TEST_DATABASE_URL=postgresql://poker:poker@localhost:5432/poker_test
