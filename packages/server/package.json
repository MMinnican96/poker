{
  "name": "@poker/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "stats:recompute": "tsx src/services/recompute.ts",
    "achievements:recompute": "tsx src/services/achievements-backfill.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:pg": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@poker/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "*",
    "vitest": "^5.0.1"
  }
}
